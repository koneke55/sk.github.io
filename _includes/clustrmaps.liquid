<!-- ClustrMaps Visitor Map -->
{% if site.clustrmaps and site.clustrmaps.enabled and site.clustrmaps.site_id %}
  <div class="clustrmaps-container" style="text-align: center; margin: 2rem 0 1.5rem 0; padding: 1.5rem 0; border-top: 1px solid var(--global-divider-color);">
    <div style="margin-bottom: 1rem;">
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--global-text-color); font-weight: 400;">Visitor Map</h3>
    </div>
    <div style="display: flex; justify-content: center; align-items: center; width: 100%; max-width: 350px; margin: 0 auto;">
      <div style="width: 100%; transform: scale(0.7); transform-origin: center;">
        <script type="text/javascript" id="clustrmaps" src="//clustrmaps.com/map_v2.js?d={{ site.clustrmaps.site_id }}&cl=ffffff&w=a"></script>
      </div>
    </div>
    <p style="font-size: 0.8rem; color: var(--global-text-color-muted); margin-top: 0.75rem;">
      <a href="https://clustrmaps.com/site/{{ site.clustrmaps.site_id }}" target="_blank" rel="noopener noreferrer" style="color: var(--global-text-color-muted); text-decoration: none;">View detailed statistics on ClustrMaps</a>
    </p>
  </div>
{% endif %}

