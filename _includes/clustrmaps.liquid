<!-- ClustrMaps Visitor Map -->
{% if site.clustrmaps and site.clustrmaps.enabled and site.clustrmaps.site_id %}
  <div class="clustrmaps-container" style="text-align: center; margin: 3rem 0 2rem 0; padding: 2rem 0; border-top: 1px solid var(--global-divider-color);">
    <div style="margin-bottom: 1.5rem;">
      <h3 style="font-size: 1.3rem; margin-bottom: 0.5rem; color: var(--global-text-color); font-weight: 400;">Visitor Map</h3>
      <p style="font-size: 0.95rem; color: var(--global-text-color-muted); margin-bottom: 1.5rem;">See where visitors are coming from around the world</p>
    </div>
    <div style="display: flex; justify-content: center; align-items: center; min-height: 400px; width: 100%;">
      <script type="text/javascript" id="clustrmaps" src="//clustrmaps.com/map_v2.js?d={{ site.clustrmaps.site_id }}&cl=ffffff&w=a"></script>
    </div>
    <p style="font-size: 0.85rem; color: var(--global-text-color-muted); margin-top: 1rem;">
      <a href="https://clustrmaps.com/site/{{ site.clustrmaps.site_id }}" target="_blank" rel="noopener noreferrer" style="color: var(--global-text-color-muted); text-decoration: none;">View detailed statistics on ClustrMaps</a>
    </p>
  </div>
{% endif %}

