<!-- Follow Me - Static Social Links -->
{% if site.data.socials %}
<div class="follow-me-inline">
  {% if site.data.socials.email %}
  <a href="mailto:{{ site.data.socials.email }}" class="social-icon-link" target="_blank" rel="noopener" title="Email">
    <i class="fas fa-envelope"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.github_username %}
  <a href="https://github.com/{{ site.data.socials.github_username }}" class="social-icon-link" target="_blank" rel="noopener" title="GitHub">
    <i class="fab fa-github"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.linkedin_username %}
  <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}" class="social-icon-link" target="_blank" rel="noopener" title="LinkedIn">
    <i class="fab fa-linkedin"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}" class="social-icon-link" target="_blank" rel="noopener" title="Google Scholar">
    <i class="ai ai-google-scholar"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.research_gate_profile %}
  <a href="https://www.researchgate.net/profile/{{ site.data.socials.research_gate_profile }}" class="social-icon-link" target="_blank" rel="noopener" title="ResearchGate">
    <i class="ai ai-researchgate"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.x_username %}
  <a href="https://x.com/{{ site.data.socials.x_username }}" class="social-icon-link" target="_blank" rel="noopener" title="X (Twitter)">
    <i class="fab fa-x-twitter"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.orcid_id %}
  <a href="https://orcid.org/{{ site.data.socials.orcid_id }}" class="social-icon-link" target="_blank" rel="noopener" title="ORCID">
    <i class="ai ai-orcid"></i>
  </a>
  {% endif %}
  
  {% if site.data.socials.rss_icon %}
  <a href="{{ site.baseurl }}/feed.xml" class="social-icon-link" target="_blank" rel="noopener" title="RSS Feed">
    <i class="fas fa-rss"></i>
  </a>
  {% endif %}
</div>
{% endif %}

